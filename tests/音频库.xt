// tests/音频库.xt — Yumo Audio 玄铁版逻辑测试（xtl t 运行）
//
// 覆盖：合成音效预加载 / 播放 / 重复播放混音 / 无效ID /
//       重取 / 移除实例 / 移除预加载 / 全局信号 / 缺失文件失败路径 / 便利接口。
//
// 环境容错：xtl t 把测试程序放到 /tmp 下运行，macOS 限制下音频设备
// 初始化可能失败（AUDIO: Failed to initialize playback device）。
// 设备可用 → 验证完整成功路径；设备不可用 → 自动降级为失败路径测试，
// 两者都不依赖真实音频文件（合成音效零资产）。

引 "../音频库.xt" 予 音频

设 失败数 = 0

函 断言(名, 条件) {
    若 条件 {
        示("✓ " & 名)
    } 否 {
        示("✗ " & 名)
        失败数 = 失败数 + 1
    }
}

// 不依赖音频设备的失败路径与全局信号测试
函 测失败路径() {
    示("── 无效 ID ──")
    断言("无效预加载ID播放失败", 音频.播放(9999).成功 == 假)
    设 中坏 = 音频.播放中?(9999)
    断言("无效实例ID播放中?失败", 中坏.成功 == 假)
    断言("无效实例ID移除失败", 音频.移除(9999).成功 == 假)
    断言("无效预加载ID移除失败", 音频.移除预加载(9999).成功 == 假)

    示("── 重取 ──")
    设 空取 = 音频.重取(9999)
    断言("重取无效ID返回空", 空取 == 空)

    示("── 缺失文件 ──")
    设 坏 = 音频.预加载("/不存在的路径/缺失.wav")
    断言("缺失文件预加载失败", 坏.成功 == 假)
    设 快 = 音频.播放文件("/不存在的路径/缺失.wav")
    断言("播放文件(缺失)失败", 快.成功 == 假)

    示("── 全局信号 ──")
    音频.设全局停止(真)
    断言("全局停止已设", 音频.取全局停止())
    音频.设全局停止(假)
    断言("全局停止已恢复", 音频.取全局停止() == 假)
    音频.设全局静音(真)
    断言("全局静音已设", 音频.取全局静音())
    音频.设全局音量(0.5)
    断言("全局音量=0.5", 音频.取全局音量() == 0.5)
}

// 依赖音频设备的完整成功路径测试
函 测成功路径() {
    示("── 预加载：合成音效 ──")
    设 合 = 音频.预加载合成(880, 100)
    断言("合成音效预加载成功", 合.成功)
    设 合ID = 合.值
    断言("预加载数=1", 音频.取预加载数() == 1)

    示("── 播放 ──")
    设 播1 = 音频.播放(合ID)
    断言("播放成功", 播1.成功)
    设 实1 = 播1.值
    断言("实例ID>0", 实1.实例ID > 0)
    断言("播放数=1", 音频.取播放数() == 1)
    设 中1 = 音频.播放中?(实1.实例ID)
    断言("播放中? 查询成功", 中1.成功)
    断言("播放中? 为真", 中1.值)

    示("── 重复播放（混音）──")
    设 播2 = 音频.播放(合ID)
    断言("重复播放成功", 播2.成功)
    断言("播放数=2", 音频.取播放数() == 2)
    断言("两次实例ID不同", 播1.值.实例ID != 播2.值.实例ID)

    示("── 重取 ──")
    设 复得 = 音频.重取(实1.实例ID)
    若 复得 == 空 {
        断言("重取有效实例返回非空", 假)
    } 否 {
        断言("重取有效实例返回非空", 复得.实例ID == 实1.实例ID)
    }

    示("── 移除实例 ──")
    设 移除1 = 音频.移除(播2.值.实例ID)
    断言("移除实例成功", 移除1.成功)
    断言("移除后播放数=1", 音频.取播放数() == 1)
    设 再取 = 音频.重取(播2.值.实例ID)
    断言("移除后实例已清", 再取 == 空)

    示("── 移除预加载 ──")
    设 移除预 = 音频.移除预加载(合ID)
    断言("移除预加载成功", 移除预.成功)
    断言("移除后预加载数=0", 音频.取预加载数() == 0)
    断言("已移除预加载不可播放", 音频.播放(合ID).成功 == 假)

    示("── 关闭后清理验证 ──")
    音频.移除(实1.实例ID)
    断言("清理后播放数=0", 音频.取播放数() == 0)
}

// 主流程：先测失败路径（永不依赖设备），再按设备可用性测成功路径
测失败路径()
设 合 = 音频.预加载合成(880, 100)
若 合.成功 {
    测成功路径()
} 否 {
    示("⚠ 音频设备不可用（xtl t 在 /tmp 运行受限），成功路径跳过")
}
音频.关闭音频()
示("")
若 失败数 == 0 {
    示("全部通过")
} 否 {
    示("失败 " & 字(失败数) & " 项")
}
