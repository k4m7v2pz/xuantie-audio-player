// 音频库.xt — Yumo Audio 音频混合播放库（玄铁重写）
//
// 对齐上游 C++ 版（keyBonk-org/audio-player）与 Rust 版（rust-yumo）的 API 语义：
//   预加载池 → 播放池 → 实例控制 → 全局信号。
// 播放后端为玄铁渲染库（raylib）的音效/音乐流槽位池：
//   - 音效：整段加载到内存（WAV），PlaySound 支持同源多实例叠加混音
//   - 音乐流：流式解码（MP3），播放/停止/更新
//   - 合成音效：生成正弦波，零资产可用
//
// 能力边界（渲染库未提供，本库不提供假 API，调用方需自行规避）：
//   - 实例级音量/暂停/位置、播放完成回调：渲染桥无对应控制，不支持
//   - 音效实例无法单独强停（raylib Sound 无实例句柄）；音乐流可停
//   - 全局静音/停止为逻辑标记：停止可真正停音乐流，音效端仅标记
//
// 数据结构（字典表示，玄铁编译器对模块内"造 自定义类型"有解析缺陷，
// 故用字典字面量 + 动态成员访问代替类）：
//   预加载项 = {"种类": 1|2|3, "句柄": 整, "路径": 字, "待删": 逻辑}
//   播放实例 = {"实例ID": 整, "预加载ID": 整, "激活": 逻辑, "种类": 整}
//   种类：1=音效 2=音乐流 3=合成音效
//
// 模块结构：本文件为库模块（被 演示.xt / tests 引用），不直接运行。

引 "渲染" 予 R

// 渲染桥未在语言层包装的底层函数，在此声明：
外 函 XT_InitAudioDevice(): 空
外 函 XT_CloseAudioDevice(): 空

// ═══════════════════════════════════════════════
// 内部状态（模块私有，跨模块请走公函）
// ═══════════════════════════════════════════════

设 预加载表 = {}              // 键=预加载ID，值=预加载项字典
设 播放表 = {}                // 键=实例ID，值=播放实例字典
设 空闲实例ID = []            // 已回收可复用的实例ID
设 下一实例ID = 1
设 设备已初始化 = 假

// 全局信号（对齐 C++ 版 yumo::global）
设 全局停止标记 = 假
设 全局静音标记 = 假
设 全局音量值: 小数 = 1.0

// ═══════════════════════════════════════════════
// 内部辅助
// ═══════════════════════════════════════════════

// 确保音频设备已初始化（幂等，首次调用生效）
函 初始化设备() {
    若 设备已初始化 == 假 {
        XT_InitAudioDevice()
        设备已初始化 = 真
    }
}

// 分配播放实例ID：优先复用空闲回收的 ID
函 分配实例ID(): 整 {
    若 空闲实例ID.长度 > 0 {
        设 号 = 空闲实例ID[0]
        空闲实例ID.删(0)
        返 号
    }
    设 号 = 下一实例ID
    下一实例ID = 下一实例ID + 1
    返 号
}

// 按预加载ID取条目（不存在返回空）
函 取预加载(预加载ID) {
    若 预加载表.包含?(预加载ID) {
        返 预加载表[预加载ID]
    }
    返 空
}

// 按实例ID取实例（不存在返回空）
函 取实例(实例ID) {
    若 播放表.包含?(实例ID) {
        返 播放表[实例ID]
    }
    返 空
}

// 提取文件扩展名（不含点，小写化）
函 扩展名(路径): 字 {
    设 点 = 路径.倒找(".")
    若 点 < 0 { 返 "" }
    设 扩 = 路径.截取(点 + 1, 路径.字符数)
    返 扩.到小写()
}

// 判断是否为音乐流格式（MP3 系）
函 是音乐流?(路径): 逻辑 {
    设 扩 = 扩展名(路径)
    返 扩 == "mp3" 或 扩 == "mp2" 或 扩 == "mp1"
}

// 真正释放渲染桥资源（按种类分派）
函 释放资源(项) {
    若 项.种类 == 2 {
        R.停音乐流(项.句柄)
        R.释音乐流(项.句柄)
    } 否 {
        R.释音效(项.句柄)
    }
}

// 统计某预加载项是否仍被激活的播放实例引用
函 被引用?(预加载ID): 逻辑 {
    遍历 k 于 播放表.键() {
        设 实 = 播放表[k]
        若 实 != 空 且 实.激活 且 实.预加载ID == 预加载ID {
            返 真
        }
    }
    返 假
}

// ═══════════════════════════════════════════════
// 公共 API — 预加载
// ═══════════════════════════════════════════════

// 预加载音频文件：按扩展名分派（.mp3 系 → 音乐流池，其余 → 音效池）
// 返回结果：成功(预加载ID) / 失败(原因)
公 函 预加载(路径) {
    初始化设备()
    设 句柄 = 若 是音乐流?(路径) {
        R.加载音乐流(路径)
    } 否 {
        R.加载音效(路径)
    }
    若 句柄 == 0 {
        返 失败("加载失败（文件缺失、解码失败或槽位耗尽）: " & 路径)
    }
    设 项种类 = 若 是音乐流?(路径) { 2 } 否 { 1 }
    设 预加载ID = 预加载表.长度
    预加载表[预加载ID] = {"种类": 项种类, "句柄": 句柄, "路径": 路径, "待删": 假}
    返 成功(预加载ID)
}

// 合成音效预加载：生成指定频率/时长的正弦波并载入音效池（零资产）
公 函 预加载合成(频率, 毫秒) {
    初始化设备()
    设 句柄 = R.合成音效(频率, 毫秒)
    若 句柄 == 0 {
        返 失败("合成音效失败（槽位耗尽）")
    }
    设 预加载ID = 预加载表.长度
    预加载表[预加载ID] = {"种类": 3, "句柄": 句柄, "路径": "合成:" & 字(频率) & "Hz/" & 字(毫秒) & "ms", "待删": 假}
    返 成功(预加载ID)
}

// 移除预加载对象：未被播放实例引用则立即释放；被引用则标记待删，播放结束后释放
公 函 移除预加载(预加载ID) {
    设 项 = 取预加载(预加载ID)
    若 项 == 空 {
        返 失败("无效的预加载ID: " & 字(预加载ID))
    }
    若 被引用?(预加载ID) {
        项.待删 = 真
        返 成功(真)
    }
    释放资源(项)
    预加载表.删(预加载ID)
    返 成功(真)
}

// 取预加载数量
公 函 取预加载数(): 整 {
    返 预加载表.长度
}

// ═══════════════════════════════════════════════
// 公共 API — 播放
// ═══════════════════════════════════════════════

// 播放预加载音频：创建播放实例并立即播放（音效可叠加混音）
公 函 播放(预加载ID) {
    初始化设备()
    设 项 = 取预加载(预加载ID)
    若 项 == 空 {
        返 失败("无效的预加载ID: " & 字(预加载ID))
    }
    若 项.待删 {
        返 失败("预加载对象已标记移除: " & 字(预加载ID))
    }
    设 实例ID = 分配实例ID()
    播放表[实例ID] = {"实例ID": 实例ID, "预加载ID": 预加载ID, "激活": 真, "种类": 项.种类}
    若 项.种类 == 2 {
        R.播音乐流(项.句柄)
    } 否 {
        R.播音效(项.句柄)
    }
    返 成功(取实例(实例ID))
}

// 便利接口：加载文件并立即播放（音效/音乐流自动分派）
// 播放完移除实例后，若预加载无其他引用则自动释放
公 函 播放文件(路径) {
    设 预载 = 预加载(路径)
    若 预载.成功 == 假 { 返 失败(预载.错误) }
    设 播 = 播放(预载.值)
    若 播.成功 == 假 {
        移除预加载(预载.值)
        返 失败(播.错误)
    }
    设 项 = 取预加载(预载.值)
    若 项 != 空 { 项.待删 = 真 }   // 用完即弃（对齐 C++ 便利接口语义）
    返 成功(播.值)
}

// 按实例ID重新获取播放实例（已移除/回收返回空）
公 函 重取(实例ID) {
    返 取实例(实例ID)
}

// 查询播放实例是否处于激活状态
公 函 播放中?(实例ID) {
    设 实 = 取实例(实例ID)
    若 实 == 空 {
        返 失败("无效的实例ID: " & 字(实例ID))
    }
    返 成功(实.激活)
}

// 取当前播放实例数量
公 函 取播放数(): 整 {
    设 数 = 0
    遍历 k 于 播放表.键() {
        设 实 = 播放表[k]
        若 实 != 空 且 实.激活 { 数 = 数 + 1 }
    }
    返 数
}

// 移除播放实例：释放逻辑记录；音乐流实例同时停止；预加载待删且无引用时释放
公 函 移除(实例ID) {
    设 实 = 取实例(实例ID)
    若 实 == 空 {
        返 失败("无效的实例ID: " & 字(实例ID))
    }
    设 项 = 取预加载(实.预加载ID)
    若 项 != 空 且 实.种类 == 2 {
        R.停音乐流(项.句柄)
    }
    播放表.删(实例ID)
    空闲实例ID.追加(实例ID)
    // 预加载对象若待删且已无任何引用，顺手释放
    若 项 != 空 且 项.待删 且 被引用?(实.预加载ID) == 假 {
        释放资源(项)
        预加载表.删(实.预加载ID)
    }
    返 成功(真)
}

// 重置全部播放：音乐流停掉重播；音效无实例控制，逻辑上重新触发播放
公 函 重置全部() {
    遍历 k 于 播放表.键() {
        设 实 = 播放表[k]
        若 实 != 空 且 实.激活 {
            设 项 = 取预加载(实.预加载ID)
            若 项 != 空 {
                若 实.种类 == 2 {
                    R.停音乐流(项.句柄)
                    R.播音乐流(项.句柄)
                } 否 {
                    R.播音效(项.句柄)
                }
            }
        }
    }
}

// ═══════════════════════════════════════════════
// 公共 API — 音乐流更新（渲染桥需周期性推进解码）
// ═══════════════════════════════════════════════

// 更新单个音乐流（透传渲染桥；主循环每帧调用）
公 函 更新音乐流(句柄) {
    R.更新音乐流(句柄)
}

// 更新全部激活的音乐流（供无主循环场景一次推进）
公 函 更新全部音乐流() {
    遍历 k 于 播放表.键() {
        设 实 = 播放表[k]
        若 实 != 空 且 实.激活 且 实.种类 == 2 {
            设 项 = 取预加载(实.预加载ID)
            若 项 != 空 { R.更新音乐流(项.句柄) }
        }
    }
}

// ═══════════════════════════════════════════════
// 公共 API — 全局信号（对齐 C++ yumo::global）
// ═══════════════════════════════════════════════

// 全局停止：真=停止全部（音乐流真正停止；音效逻辑标记）
公 函 设全局停止(开) {
    全局停止标记 = 开
    若 开 {
        遍历 k 于 播放表.键() {
            设 实 = 播放表[k]
            若 实 != 空 且 实.激活 且 实.种类 == 2 {
                设 项 = 取预加载(实.预加载ID)
                若 项 != 空 { R.停音乐流(项.句柄) }
            }
        }
    }
}

公 函 取全局停止(): 逻辑 {
    返 全局停止标记
}

// 全局静音：逻辑标记（渲染桥无主音量控制，音效/音乐流实际不静音）
公 函 设全局静音(开) {
    全局静音标记 = 开
}

公 函 取全局静音(): 逻辑 {
    返 全局静音标记
}

// 全局音量：逻辑占位（渲染桥无音量控制，实际不生效）
公 函 设全局音量(音量) {
    全局音量值 = 音量
}

公 函 取全局音量(): 小数 {
    返 全局音量值
}

// ═══════════════════════════════════════════════
// 公共 API — 设备生命周期
// ═══════════════════════════════════════════════

// 释放全部资源并关闭音频设备（程序退出前调用；不调用则进程退出自动回收）
公 函 关闭音频() {
    遍历 k 于 预加载表.键() {
        设 项 = 预加载表[k]
        若 项 != 空 { 释放资源(项) }
    }
    遍历 k 于 播放表.键() {
        播放表.删(k)
    }
    当 空闲实例ID.长度 > 0 {
        空闲实例ID.删(空闲实例ID.长度 - 1)
    }
    下一实例ID = 1
    若 设备已初始化 {
        XT_CloseAudioDevice()
        设备已初始化 = 假
    }
}
