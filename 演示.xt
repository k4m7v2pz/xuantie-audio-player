// 演示.xt — Yumo Audio 玄铁版演示入口（xtl.json 声明的项目入口）
//
// 流程：合成音效预加载 → 播放（含叠加混音）→ 状态输出 → 全局停止演示
//       → 实例清理 → 关闭音频。零资产（合成音效，不依赖外部音频文件）。
// 注：上游 C++ 的测试素材（test/audio/）已随 C++ 历史移除（见 git 历史），
//     如需演示真实文件播放，用 音频.预加载("你的文件.wav") 代替合成音效。

引 "./音频库.xt" 予 音频

示("════════ Yumo Audio 玄铁版演示 ════════")

// ── 1. 合成音效（零资产，随时可用）──
设 合 = 音频.预加载合成(440, 300)
设 实例1 = 0
设 实例2 = 0
若 合.成功 {
    设 合ID = 合.值
    设 播1 = 音频.播放(合ID)
    设 播2 = 音频.播放(合ID)   // 同源二次播放：叠加混音
    若 播1.成功 {
        实例1 = 播1.值.实例ID
        示("合成音效实例1: " & 字(实例1))
    }
    若 播2.成功 {
        实例2 = 播2.值.实例ID
        示("合成音效实例2: " & 字(实例2) & "（叠加混音）")
    }
} 否 {
    示("合成音效预加载失败: " & 合.错误)
}

// ── 2. 状态输出 ──
示("预加载数: " & 字(音频.取预加载数()))
示("播放数: " & 字(音频.取播放数()))
示("等待播放 800ms ...")
时.睡(800)

// ── 3. 全局停止 / 恢复演示 ──
音频.设全局停止(真)
示("全局停止已设（音乐流真正停止，音效为逻辑标记）")
时.睡(300)
音频.设全局停止(假)
示("全局停止已恢复")

// ── 4. 实例清理 ──
设 移除数 = 0
若 实例1 > 0 且 音频.移除(实例1).成功 { 移除数 = 移除数 + 1 }
若 实例2 > 0 且 音频.移除(实例2).成功 { 移除数 = 移除数 + 1 }
示("已移除实例: " & 字(移除数) & "，剩余播放数: " & 字(音频.取播放数()))

// ── 5. 收尾 ──
音频.关闭音频()
示("════════ 演示结束 ════════")
